#!/usr/bin/make -f

export DH_VERBOSE = 1

%:
	dh $@

override_dh_auto_build:
	chmod +x gradlew
	bash gradlew packageDeb --no-daemon -Pfocusflow.java.version=17

override_dh_auto_install:
	mkdir -p debian/focusflow
	DEB=$$(find build/compose/binaries/main/deb -maxdepth 1 -name '*.deb' -print -quit); \
	test -n "$$DEB"; \
	dpkg-deb -x "$$DEB" debian/focusflow

override_dh_auto_clean:
	bash gradlew clean --no-daemon -Pfocusflow.java.version=17 || true