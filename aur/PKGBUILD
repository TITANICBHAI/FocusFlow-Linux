# Maintainer: FocusFlow contributors
pkgname=focusflow-bin
pkgver=1.1.6
pkgrel=1
pkgdesc="Focus and productivity app with real app blocking (binary AppImage release)"
arch=('x86_64')
url="https://github.com/TITANICBHAI/FocusFlow-Linux"
license=('custom')
depends=('xdotool' 'wmctrl' 'libnotify')
makedepends=('curl')
optdepends=('polkit: needed for iptables-based network blocking (optional)')
provides=('focusflow')
conflicts=('focusflow')

source=(
    "focusflow-${pkgver}.AppImage::https://github.com/TITANICBHAI/FocusFlow-Linux/releases/download/v${pkgver}/FocusFlow-${pkgver}-x86_64.AppImage"
    "SHA256SUMS::https://github.com/TITANICBHAI/FocusFlow-Linux/releases/download/v${pkgver}/SHA256SUMS"
)

# The release workflow publishes SHA256SUMS alongside the AppImage. The current
# repository snapshot predates its first Linux asset, so a fabricated static
# hash would be worse than an empty makepkg array. prepare() performs the
# version-pinned manifest check before package() runs.
sha256sums=()

prepare() {
    local asset="focusflow-${pkgver}.AppImage"
    local expected
    expected="$(awk -v file="FocusFlow-${pkgver}-x86_64.AppImage" \
        '$2 == file || $2 == "*" file { print $1; exit }' SHA256SUMS)"
    [[ "$expected" =~ ^[0-9a-fA-F]{64}$ ]] \
        || { echo "SHA256SUMS has no valid entry for the FocusFlow AppImage" >&2; return 1; }
    printf '%s  %s\n' "$expected" "$asset" | sha256sum -c -
}

package() {
    # Install AppImage
    install -Dm755 "focusflow-${pkgver}.AppImage" \
        "${pkgdir}/usr/lib/focusflow/focusflow.AppImage"

    # Launcher shim in /usr/bin
    install -dm755 "${pkgdir}/usr/bin"
    cat > "${pkgdir}/usr/bin/focusflow" <<EOF
#!/usr/bin/env bash
exec /usr/lib/focusflow/focusflow.AppImage "\$@"
EOF
    chmod 755 "${pkgdir}/usr/bin/focusflow"

    # .desktop entry
    install -dm755 "${pkgdir}/usr/share/applications"
    cat > "${pkgdir}/usr/share/applications/focusflow.desktop" <<EOF
[Desktop Entry]
Name=FocusFlow
Comment=Focus and productivity app with real app blocking
Exec=/usr/lib/focusflow/focusflow.AppImage
Icon=focusflow
Type=Application
Categories=Utility;
StartupNotify=true
EOF

    # Extract icon from AppImage
    cd "${srcdir}"
    chmod +x "focusflow-${pkgver}.AppImage"
    APPIMAGE_EXTRACT_AND_RUN=1 "./focusflow-${pkgver}.AppImage" --appimage-extract \
        usr/share/pixmaps/focusflow.png 2>/dev/null || true
    if [ -f squashfs-root/usr/share/pixmaps/focusflow.png ]; then
        install -Dm644 squashfs-root/usr/share/pixmaps/focusflow.png \
            "${pkgdir}/usr/share/pixmaps/focusflow.png"
    fi
}
